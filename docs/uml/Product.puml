@startuml

title Product API - Tutorial 5 Abstract Class and Interface

abstract class Product {
    - id : Long
    - name : String
    - price : double
    + {abstract} getSummary() : String
    + getId() : Long
    + getName() : String
    + getPrice() : double
    + setId(id : Long) : void
    + setName(name : String) : void
    + setPrice(price : double) : void
}

interface Discountable <<interface>> {
    + applyDiscount(rate : double) : void
    + getDiscountedPrice() : double
}

class DigitalProduct {
    - downloadUrl : String
    - fileSizeMB : double
    - discountedPrice : double
    + getSummary() : String
    + applyDiscount(rate : double) : void
    + getDiscountedPrice() : double
    + getDownloadUrl() : String
    + getFileSizeMB() : double
}

class PhysicalProduct {
    - weightKg : double
    - dimensions : String
    - discountedPrice : double
    + getSummary() : String
    + applyDiscount(rate : double) : void
    + getDiscountedPrice() : double
    + getWeightKg() : double
    + getDimensions() : String
}

class ProductService {
    - products : List<Product>
    - nextId : Long
    + getAllProducts() : List<Product>
    + getAllSummaries() : List<String>
    + getProductById(id : Long) : Optional<Product>
    + addProduct(product : Product) : Product
    + deleteProduct(id : Long) : void
    + findByName(name : String) : List<Product>
}

class ProductController {
    - productService : ProductService
    + getAllProducts() : List<Product>
    + getAllSummaries() : List<String>
    + getProductById(id : Long) : Product
    + addProduct(product : DigitalProduct) : Product
    + deleteProduct(id : Long) : void
}

' <|-- generalisation (extends): SOLID line
Product <|-- DigitalProduct
Product <|-- PhysicalProduct

' <|.. realisation (implements): DASHED line
Discountable <|.. DigitalProduct
Discountable <|.. PhysicalProduct

' Tutorial 3 - Dependency relationship
ProductController ..> ProductService

' Tutorial 3 - Association relationship
ProductService --> Product

@enduml
